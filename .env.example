# Base URL of the NutriBasket Express backend.
# Leave empty in development — Vite proxies /api to http://localhost:3001.
# In production set to your deployed backend, e.g. https://nutribasket.onrender.com
VITE_API_URL=

# Google OAuth client ID for "Connect with Google" (Google Identity Services).
# Leave empty to disable the Google button — the app works fine without it.
# Create one at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
